<Window
    x:Class="WebBrowserApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WebBrowserApp"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*" Margin="10">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBox x:Name="AddressBox" Width="400" PlaceholderText="Enter URL"/>
            <Button x:Name="GoButton" Content="Go" Click="OnGoClicked" />
        </StackPanel>
        <WebView2 x:Name="Browser" Grid.Row="1"/>
    </Grid>
</Window>
