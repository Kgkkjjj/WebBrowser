<Window
    x:Class="WebBrowserApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:WebBrowserApp"
    mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBox x:Name="AddressBox" Width="400" PlaceholderText="Enter URL"/>
            <Button x:Name="GoButton" Content="Go" Click="OnGoClicked" />
        </StackPanel>
        <WebView2 x:Name="Browser" Grid.Row="1"/>
        <StackPanel Grid.Row="2" Spacing="5" Margin="0,10,0,0">
            <TextBox x:Name="PromptBox" PlaceholderText="Ask the AI model"/>
            <Button x:Name="AskButton" Content="Ask" Click="OnAskClicked" />
            <TextBlock x:Name="AiResponseText" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
